# Database connection (PostGIS-enabled Postgres)
DATABASE_URL=postgresql://nivaran:nivaran_dev@localhost:5432/nivaran

# Sentence-transformer model for embedding generation
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Voice intake (ASR / TTS) ──────────────────────────────────────────
# Sarvam AI API key. OPTIONAL. Get a key at https://www.sarvam.ai/
SARVAM_API_KEY=
# Use /speech-to-text (native-script transcription). Do NOT point this at
# /speech-to-text-translate — that always returns an English translation,
# which is why non-English/Hindi complaints appeared broken.
SARVAM_ASR_URL=https://api.sarvam.ai/speech-to-text
SARVAM_ASR_MODEL=saarika:v2.5      # or "saaras:v4" (send with mode=transcribe)
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
# Text translation (vernacular transcript -> English for the bilingual
# "We heard …" display and officer readability). mayura:v1 | sarvam-translate:v1
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1

# Groq API key (Groq-hosted Whisper). OPTIONAL. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo

# Ordered fallback chain, tried left-to-right until one succeeds.
# ASR options:  sarvam  (cloud, best for Indic; needs key)
#               groq    (Groq-hosted Whisper large-v3; needs key, very fast/cheap)
#               whisper (local faster-whisper, offline; needs `faster-whisper`)
#               google  (free Google Web Speech; no key, rate-limited, EN-biased)
# TTS options:  sarvam  (natural voices; needs key)
#               gtts    (Google Translate TTS; no key, robotic, all Indic langs)
ASR_BACKENDS=sarvam,groq,whisper
TTS_BACKENDS=sarvam,gtts

# ASR_MODE controls how the ASR backends are combined:
#   fallback     try ASR_BACKENDS in order, first success wins (fast, 1 call)
#   orchestrate  run ASR_ENSEMBLE in parallel, cross-check every transcript's
#                language (Unicode script + langdetect), hold a weighted vote,
#                and return the transcript that best matches the winning
#                language. Slower / more API calls, but fixes wrong-language
#                output. The chosen engine + vote breakdown is returned in the
#                voice response under "refinement".
ASR_MODE=fallback
ASR_ENSEMBLE=sarvam,groq,whisper

# faster-whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=small

# Per-request HTTP timeout (seconds) for cloud voice APIs
VOICE_HTTP_TIMEOUT=30

# NOTE: every transcript's language is reconciled (Unicode script +
# langdetect cross-check, incl. Hindi/Marathi/Nepali disambiguation)
# regardless of what the ASR engine reports, so Sarvam's weak language
# detection no longer drives the result. The citizen can also pick a
# language in the UI; it is forwarded to every engine as a hint.
